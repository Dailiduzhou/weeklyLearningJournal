# Dockerfile with build arguments for flexibility
FROM golang:1.24-alpine AS builder

ARG GOPROXY=https://goproxy.cn,direct
ARG GO111MODULE=on

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache git gcc musl-dev

# Set environment variables
ENV GOPROXY=${GOPROXY}
ENV GO111MODULE=${GO111MODULE}

# Copy dependency files first
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o user ./cmd/user.go

# Runtime stage
FROM alpine:latest

WORKDIR /app

# Install runtime dependencies
RUN apk --no-cache add ca-certificates tzdata

# Copy binary and config
COPY --from=builder /build/user .
COPY --from=builder /build/cmd/etc/user-docker.yaml ./etc/user.yaml

EXPOSE 8888

ENV TZ=Asia/Shanghai

CMD ["./user", "-f", "etc/user.yaml"]
