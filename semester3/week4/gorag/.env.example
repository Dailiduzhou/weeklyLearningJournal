# Copy this file to .env before running Docker Compose. Do not commit .env.
POSTGRES_DB=gorag
POSTGRES_USER=gorag
POSTGRES_PASSWORD=replace-with-a-long-random-password
GORAG_POSTGRES_PORT=5432
GORAG_DATABASE_URL=postgres://gorag:replace-with-a-long-random-password@postgres:5432/gorag?sslmode=disable

GORAG_SERVER_ADDRESS=:8080
GORAG_OLLAMA_BASE_URL=http://ollama:11434
GORAG_OLLAMA_PORT=11434
GORAG_OLLAMA_TIMEOUT=30s
GORAG_EMBEDDING_DIMENSION=1024
GORAG_EMBEDDING_BATCH_SIZE=16
GORAG_EMBEDDING_MAX_CONCURRENCY=1
GORAG_INDEXING_DOCUMENT_CONCURRENCY=1
GORAG_DOCUMENTS_DIR=/app/docs
GORAG_RETRIEVAL_TOP_K=10
GORAG_RETRIEVAL_MAX_CONTEXT=5
GORAG_RETRIEVAL_SIMILARITY_THRESHOLD=0.5
GORAG_RETRIEVAL_VECTOR_ENABLED=true
GORAG_RETRIEVAL_BM25_ENABLED=false
GORAG_RETRIEVAL_BM25_INDEX_PATH=/app/data/bm25
GORAG_RETRIEVAL_BM25_MIN_SCORE=0

# ollama and openai-compatible are supported providers.
GORAG_ANSWER_PROVIDER=ollama
GORAG_ANSWER_BASE_URL=http://ollama:11434
GORAG_ANSWER_MODEL=qwen3:4b
GORAG_ANSWER_API_KEY=
GORAG_ANSWER_TIMEOUT=60s

# Optional LLM rerank: independent credentials/model, no readiness dependency.
# Fill the endpoint/model and inject the secret before setting enabled=true.
GORAG_RERANK_ENABLED=false
GORAG_RERANK_PROVIDER=openai-compatible
GORAG_RERANK_BASE_URL=
GORAG_RERANK_MODEL=
GORAG_RERANK_API_KEY=
GORAG_RERANK_TIMEOUT=30s
GORAG_RERANK_MAX_INPUT_CHARS=24000
GORAG_RERANK_MAX_CONCURRENCY=1

GORAG_STARTUP_CHECK_TIMEOUT=30s
GORAG_STARTUP_RETRY_INTERVAL=1s
GORAG_IMAGE_TAG=local
