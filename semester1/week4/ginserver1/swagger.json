{
  "swagger": "2.0",
  "info": {
    "description": "这是一个基于Gin框架的用户管理系统API，提供用户注册、登录、个人信息管理等功能",
    "title": "用户管理API",
    "version": "1.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json",
    "application/x-www-form-urlencoded"
  ],
  "produces": [
    "application/json",
    "text/html"
  ],
  "paths": {
    "/changepassword": {
      "get": {
        "description": "返回修改密码页面",
        "produces": [
          "text/html"
        ],
        "tags": [
          "页面"
        ],
        "operationId": "changePasswordPage",
        "responses": {
          "200": {
            "description": "成功返回修改密码页面"
          }
        }
      },
      "post": {
        "description": "修改用户密码",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "text/html",
          "application/json"
        ],
        "tags": [
          "用户"
        ],
        "operationId": "changePassword",
        "parameters": [
          {
            "type": "string",
            "description": "用户名",
            "name": "username",
            "in": "formData",
            "required": true
          },
          {
            "type": "string",
            "description": "原密码",
            "name": "oldpassword",
            "in": "formData",
            "required": true
          },
          {
            "type": "string",
            "description": "新密码",
            "name": "password",
            "in": "formData",
            "required": true
          },
          {
            "type": "string",
            "description": "确认新密码",
            "name": "password1",
            "in": "formData",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "密码修改成功",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "400": {
            "description": "用户不存在或两次密码不一致或信息为空",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "403": {
            "description": "原密码错误",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          }
        }
      }
    },
    "/changeprofiles": {
      "get": {
        "description": "返回修改个人信息页面",
        "produces": [
          "text/html"
        ],
        "tags": [
          "页面"
        ],
        "operationId": "changeProfilePage",
        "parameters": [
          {
            "type": "string",
            "description": "JWT认证令牌",
            "name": "token",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "用户名",
            "name": "username",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回修改个人信息页面"
          },
          "400": {
            "description": "认证令牌和用户名不能为空",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "401": {
            "description": "无效或已过期的认证令牌",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          }
        }
      },
      "post": {
        "description": "修改用户个人信息",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "用户"
        ],
        "operationId": "changeProfile",
        "parameters": [
          {
            "type": "string",
            "description": "原用户名",
            "name": "username",
            "in": "formData",
            "required": true
          },
          {
            "type": "string",
            "description": "新用户名",
            "name": "newusername",
            "in": "formData"
          },
          {
            "type": "string",
            "description": "新姓名",
            "name": "newname",
            "in": "formData"
          }
        ],
        "responses": {
          "200": {
            "description": "信息修改成功",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "400": {
            "description": "未发生更改或用户名/姓名与原值相同或信息为空",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "description": "返回 Swagger UI 界面",
        "produces": [
          "text/html"
        ],
        "tags": [
          "文档"
        ],
        "operationId": "getSwaggerUI",
        "responses": {
          "200": {
            "description": "成功返回 Swagger UI"
          }
        }
      }
    },
    "/login": {
      "get": {
        "description": "返回用户登录页面",
        "produces": [
          "text/html"
        ],
        "tags": [
          "页面"
        ],
        "operationId": "loginPage",
        "responses": {
          "200": {
            "description": "成功返回登录页面"
          }
        }
      },
      "post": {
        "description": "用户登录并返回JWT令牌",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "用户"
        ],
        "operationId": "loginUser",
        "parameters": [
          {
            "type": "string",
            "description": "用户名",
            "name": "username",
            "in": "formData",
            "required": true
          },
          {
            "type": "string",
            "description": "密码",
            "name": "password",
            "in": "formData",
            "required": true
          }
        ],
        "responses": {
          "302": {
            "description": "登录成功，重定向到个人资料页面"
          },
          "400": {
            "description": "用户不存在或信息为空",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "403": {
            "description": "密码错误",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          }
        }
      }
    },
    "/profiles": {
      "get": {
        "description": "返回用户个人资料页面",
        "produces": [
          "text/html"
        ],
        "tags": [
          "用户"
        ],
        "operationId": "getProfile",
        "parameters": [
          {
            "type": "string",
            "description": "JWT认证令牌",
            "name": "token",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "用户名",
            "name": "username",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回个人资料页面"
          },
          "400": {
            "description": "认证令牌和用户名不能为空",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "401": {
            "description": "无效或已过期的认证令牌",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          }
        }
      }
    },
    "/register": {
      "get": {
        "description": "返回用户注册页面",
        "produces": [
          "text/html"
        ],
        "tags": [
          "页面"
        ],
        "operationId": "registerPage",
        "responses": {
          "200": {
            "description": "成功返回注册页面"
          }
        }
      },
      "post": {
        "description": "注册新用户",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "用户"
        ],
        "operationId": "registerUser",
        "parameters": [
          {
            "type": "string",
            "description": "用户名",
            "name": "username",
            "in": "formData",
            "required": true
          },
          {
            "type": "string",
            "description": "密码",
            "name": "password",
            "in": "formData",
            "required": true
          },
          {
            "type": "string",
            "description": "姓名",
            "name": "name",
            "in": "formData",
            "required": true
          }
        ],
        "responses": {
          "202": {
            "description": "注册成功",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "400": {
            "description": "用户已存在或信息为空",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "500": {
            "description": "服务器内部错误",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          }
        }
      }
    },
    "/swagger.json": {
      "get": {
        "description": "返回 Swagger JSON 格式的 API 文档",
        "produces": [
          "application/json"
        ],
        "tags": [
          "文档"
        ],
        "operationId": "getSwaggerJSON",
        "responses": {
          "200": {
            "description": "成功返回 Swagger JSON 文档"
          }
        }
      }
    },
    "/userdata": {
      "get": {
        "description": "管理员查看所有用户数据",
        "produces": [
          "application/json"
        ],
        "tags": [
          "用户"
        ],
        "operationId": "getUserData",
        "parameters": [
          {
            "type": "string",
            "description": "用户名（必须为admin）",
            "name": "username",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "JWT认证令牌",
            "name": "token",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回用户数据",
            "schema": {
              "type": "object",
              "properties": {
                "users": {
                  "type": "object",
                  "description": "用户数据映射"
                },
                "count": {
                  "type": "integer",
                  "description": "用户数量"
                }
              }
            }
          },
          "400": {
            "description": "用户名和认证令牌不能为空",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          },
          "403": {
            "description": "权限不足或token失效",
            "schema": {
              "$ref": "#/definitions/APIResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "User": {
      "type": "object",
      "required": [
        "username",
        "password",
        "name"
      ],
      "properties": {
        "username": {
          "type": "string",
          "example": "john_doe"
        },
        "password": {
          "type": "string",
          "example": "password123"
        },
        "name": {
          "type": "string",
          "example": "John Doe"
        }
      }
    },
    "LoginRequest": {
      "type": "object",
      "required": [
        "username",
        "password"
      ],
      "properties": {
        "username": {
          "type": "string",
          "example": "john_doe"
        },
        "password": {
          "type": "string",
          "example": "password123"
        }
      }
    },
    "RegisterRequest": {
      "type": "object",
      "required": [
        "username",
        "password",
        "name"
      ],
      "properties": {
        "username": {
          "type": "string",
          "example": "john_doe"
        },
        "password": {
          "type": "string",
          "example": "password123"
        },
        "name": {
          "type": "string",
          "example": "John Doe"
        }
      }
    },
    "ChangePasswordRequest": {
      "type": "object",
      "required": [
        "username",
        "oldpassword",
        "password",
        "password1"
      ],
      "properties": {
        "username": {
          "type": "string",
          "example": "john_doe"
        },
        "oldpassword": {
          "type": "string",
          "example": "oldpassword123"
        },
        "password": {
          "type": "string",
          "example": "newpassword123"
        },
        "password1": {
          "type": "string",
          "example": "newpassword123"
        }
      }
    },
    "ChangeProfileRequest": {
      "type": "object",
      "required": [
        "username"
      ],
      "properties": {
        "username": {
          "type": "string",
          "example": "john_doe"
        },
        "newusername": {
          "type": "string",
          "example": "john_new"
        },
        "newname": {
          "type": "string",
          "example": "John New"
        }
      }
    },
    "APIResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    }
  },
  "securityDefinitions": {
    "JWT": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT认证令牌，格式为\"Bearer {token}\""
    }
  }
}